rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: Check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Stickers klasörü - herkes okuyabilir, sadece admin yazabilir
    match /stickers/{packId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Premium stickers klasörü - herkes okuyabilir, sadece admin yazabilir
    match /premium_stickers/{packId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // UGC uploads - auth kullanıcılar kendi klasörlerine yazabilir
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB per file
        && request.resource.contentType.matches('image/.*');  // Only images
    }

    // User profile images
    match /user_profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024  // Max 2MB
        && request.resource.contentType.matches('image/.*');
    }
    
    // Diğer tüm yollar - sadece admin yazabilir
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
