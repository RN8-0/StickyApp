#!/bin/bash
# =============================================================================
# STICKER YÜKLEYICI - Otomatik Kurulum ve Çalıştırma (Linux/macOS)
# =============================================================================
# Bu script:
# 1. Gerekli bağımlılıkları kontrol eder ve kurar
# 2. Python virtual environment oluşturur
# 3. Stickerleri Firebase'e ve GitHub'a yükler
# =============================================================================

set -e

# Renk kodları
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Script dizinine git
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo -e "${BLUE}============================================================${NC}"
echo -e "${BLUE}   STICKER YÜKLEYICI - Otomatik Kurulum${NC}"
echo -e "${BLUE}============================================================${NC}"
echo ""

# Python kontrolü
echo -e "${YELLOW}[1/5]${NC} Python kontrol ediliyor..."
if command -v python3 &> /dev/null; then
    PYTHON_VERSION=$(python3 --version 2>&1)
    echo -e "   ${GREEN}✓${NC} $PYTHON_VERSION"
else
    echo -e "   ${RED}✗ Python3 bulunamadı!${NC}"
    echo ""
    echo "   Kurulum:"
    echo "   Ubuntu/Debian: sudo apt install python3 python3-venv python3-pip"
    echo "   macOS: brew install python3"
    echo ""
    read -p "Devam etmek için bir tuşa basın..."
    exit 1
fi

# FFmpeg kontrolü
echo -e "${YELLOW}[2/5]${NC} FFmpeg kontrol ediliyor..."
if command -v ffmpeg &> /dev/null; then
    echo -e "   ${GREEN}✓${NC} FFmpeg yüklü"
else
    echo -e "   ${YELLOW}⚠ FFmpeg bulunamadı, kuruluyor...${NC}"
    if command -v apt &> /dev/null; then
        sudo apt update && sudo apt install -y ffmpeg
    elif command -v brew &> /dev/null; then
        brew install ffmpeg
    else
        echo -e "   ${RED}✗ FFmpeg kurulamadı!${NC}"
        echo "   Manuel kurulum: sudo apt install ffmpeg"
        read -p "Devam etmek için bir tuşa basın..."
        exit 1
    fi
    echo -e "   ${GREEN}✓${NC} FFmpeg kuruldu"
fi

# Virtual environment kontrolü ve kurulumu
echo -e "${YELLOW}[3/5]${NC} Python ortamı hazırlanıyor..."
if [ ! -d "venv" ]; then
    echo "   Virtual environment oluşturuluyor..."
    python3 -m venv venv
    echo -e "   ${GREEN}✓${NC} venv oluşturuldu"
fi

# Pip ve bağımlılıkları yükle
echo -e "${YELLOW}[4/5]${NC} Bağımlılıklar kontrol ediliyor..."
VENV_PIP="./venv/bin/pip"
VENV_PYTHON="./venv/bin/python3"

# Pip'i güncelle
$VENV_PIP install --upgrade pip -q 2>/dev/null || true

# Firebase admin kontrol et ve yükle
if ! $VENV_PYTHON -c "import firebase_admin" 2>/dev/null; then
    echo "   firebase-admin yükleniyor..."
    $VENV_PIP install firebase-admin -q
    echo -e "   ${GREEN}✓${NC} firebase-admin yüklendi"
else
    echo -e "   ${GREEN}✓${NC} firebase-admin mevcut"
fi

# rembg kontrol et ve yükle
if ! $VENV_PYTHON -c "import rembg" 2>/dev/null; then
    echo "   rembg yükleniyor (bu biraz sürebilir)..."
    $VENV_PIP install "rembg[cpu]" -q
    echo -e "   ${GREEN}✓${NC} rembg yüklendi"
else
    echo -e "   ${GREEN}✓${NC} rembg mevcut"
fi

# Firebase Admin SDK key kontrolü
echo -e "${YELLOW}[5/5]${NC} Firebase yapılandırması kontrol ediliyor..."
FIREBASE_KEY=$(find . -maxdepth 1 -name "*firebase-adminsdk*.json" -type f | head -1)
if [ -z "$FIREBASE_KEY" ]; then
    echo -e "   ${RED}✗ Firebase Admin SDK anahtarı bulunamadı!${NC}"
    echo ""
    echo "   Anahtar dosyasını şuraya koyun:"
    echo "   $SCRIPT_DIR/"
    echo ""
    echo "   Dosyayı almak için:"
    echo "   1. https://console.firebase.google.com adresine gidin"
    echo "   2. Proje Ayarları > Hizmet Hesapları"
    echo "   3. 'Yeni Özel Anahtar Oluştur' tıklayın"
    echo "   4. İndirilen JSON dosyasını bu klasöre koyun"
    echo ""
    read -p "Devam etmek için bir tuşa basın..."
    exit 1
else
    echo -e "   ${GREEN}✓${NC} Firebase anahtarı bulundu"
fi

echo ""
echo -e "${GREEN}============================================================${NC}"
echo -e "${GREEN}   KURULUM TAMAMLANDI - Sticker yükleyici başlatılıyor...${NC}"
echo -e "${GREEN}============================================================${NC}"
echo ""

# Ana scripti çalıştır
$VENV_PYTHON upload_stickers.py

echo ""
echo -e "${GREEN}İşlem tamamlandı!${NC}"
echo ""
read -p "Kapatmak için bir tuşa basın..."
