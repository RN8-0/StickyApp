rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sticker paketleri - herkes okuyabilir, herkes istatistik güncelleyebilir
    match /stickers/{document=**} {
      allow read: if true;
      allow update: if true; // İstatistiklerin artması için anonim izne ihtiyaç var
      allow create, delete: if request.auth != null;
    }
    
    // Premium sticker paketleri
    match /premium_stickers/{document=**} {
      allow read: if true;
      allow update: if true; 
      allow create, delete: if request.auth != null;
    }
    
    // Ayarlar - herkes okuyabilir, sadece auth yazabilir
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Mesajlar - herkes yazabilir (anonim kullanıcılar için), sadece auth okuyabilir
    match /messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Öneriler - herkes yazabilir (anonim kullanıcılar için), sadece auth okuyabilir
    match /suggestions/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Bildirimler - sadece auth yazabilir (Admin), herkes okuyabilir
    match /notifications/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Otomasyon Taslakları - sadece auth (Admin) okuyabilir ve yönetebilir
    match /automation_drafts/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
