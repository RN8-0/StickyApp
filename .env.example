# PocketBase
PB_URL=https://your-pocketbase-instance.com
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASS=your-secure-password

# Firebase / FCM
FIREBASE_SERVICE_ACCOUNT_JSON={}
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-sa-key.json

# Worker
ADMIN_SECRET=your-admin-secret-key
PORT=3000

# 3rd Party APIs
GIPHY_API_KEY=your-giphy-api-key
KLIPY_API_KEY=your-klipy-api-key

# NudeNet (self-hosted)
NUDENET_URL=http://nudenet:8080

# Notifications
NTFY_URL=http://ntfy:80
NTFY_TOPIC=sticky-stickers

# Admin Web
VITE_PB_URL=https://your-pocketbase-instance.com
VITE_PB_PUBLIC_URL=https://your-pocketbase-instance.com
VITE_WORKER_URL=https://your-worker-instance.com
VITE_IMAGE_PROXY_URL=https://your-image-proxy.com
