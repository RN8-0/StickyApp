<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crop_shape_title"
        android:textColor="@color/modern_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/cropButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnCropNone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_emoji_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCropNone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_crop_none"
                android:scaleType="centerInside"
                app:tint="@color/modern_primary" />

            <TextView
                android:id="@+id/labelCropNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/crop_none"
                android:textColor="@color/modern_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCropCircle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_emoji_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCropCircle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_crop_circle"
                android:scaleType="centerInside"
                app:tint="@color/modern_primary" />

            <TextView
                android:id="@+id/labelCropCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/crop_circle"
                android:textColor="@color/modern_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCropSquare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_emoji_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCropSquare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_crop_square"
                android:scaleType="centerInside"
                app:tint="@color/modern_primary" />

            <TextView
                android:id="@+id/labelCropSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/crop_square"
                android:textColor="@color/modern_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCropRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_emoji_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCropRect"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_crop_rect"
                android:scaleType="centerInside"
                app:tint="@color/modern_primary" />

            <TextView
                android:id="@+id/labelCropRect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/crop_rectangle"
                android:textColor="@color/modern_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
