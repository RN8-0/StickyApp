<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/packTop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:rippleColor="#20000000"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Sıra Numarası - Büyük ve Şık -->
        <TextView
            android:id="@+id/rankNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="1"
            android:textColor="@color/accent"
            android:textSize="52sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bilgi Alanı -->
        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/rankNumber"
            app:layout_constraintEnd_toStartOf="@id/statusIcons"
            app:layout_constraintStart_toEndOf="@id/rankNumber"
            app:layout_constraintTop_toTopOf="@id/rankNumber">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Paket İsmi"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/pub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Yayıncı"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- İndirme Sayısı -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/downloadIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_download_small"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/downloadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="10K"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status Icons -->
        <LinearLayout
            android:id="@+id/statusIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@id/btnAdd"
            app:layout_constraintEnd_toStartOf="@id/btnAdd"
            app:layout_constraintTop_toTopOf="@id/btnAdd">

            <ImageView
                android:id="@+id/crownIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crown"
                android:visibility="gone"
                app:tint="@color/premium_gold" />

            <FrameLayout
                android:id="@+id/premiumContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/installedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="INSTALLED"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/checkIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/whatsapp_green" />
            
             <!-- Hidden Favorite (Adapter expects it) -->
             <ImageView android:id="@+id/btnFavoriteNew" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>
        </LinearLayout>

        <!-- Action Button (Top Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_add_short"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:icon="@drawable/ic_add"
            app:iconSize="14dp"
            app:iconTint="@color/white"
            app:iconPadding="4dp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/rankNumber"
            app:layout_constraintVertical_bias="0.2"/>

        <!-- Sticker Grid / Row -->
        <LinearLayout
            android:id="@+id/stickerPreviewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
