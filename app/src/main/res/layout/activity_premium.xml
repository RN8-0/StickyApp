<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/premium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Image with Crown -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <ImageView
            android:id="@+id/headerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/premium_header_bg" />

        <ImageView
            android:id="@+id/headerCrown"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_premium_crown_large" />

    </FrameLayout>

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_semi_transparent"
        android:src="@drawable/ic_close"
        android:padding="10dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/white"
        android:contentDescription="@string/close" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Spacer for header -->
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <!-- Content Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_premium_content_top"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="220dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sticky"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_plus_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PREMIUM"
                        android:textColor="@color/premium_text_on_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Slogan -->
                <TextView
                    android:id="@+id/tvSlogan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/premium_slogan"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Features List -->
                <LinearLayout
                    android:id="@+id/featuresContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <!-- Feature 1: Ad-Free -->
                    <include
                        android:id="@+id/featureAdFree"
                        layout="@layout/item_premium_feature" />

                    <!-- Feature 2: Premium Packs -->
                    <include
                        android:id="@+id/featurePremiumPacks"
                        layout="@layout/item_premium_feature" />

                    <!-- Feature 3: AI Background Removal -->
                    <include
                        android:id="@+id/featureAIBg"
                        layout="@layout/item_premium_feature" />

                    <!-- Feature 4: Unlimited Sticker Creation -->
                    <include
                        android:id="@+id/featureStickerMaker"
                        layout="@layout/item_premium_feature" />

                    <!-- Feature 5: Priority Support -->
                    <include
                        android:id="@+id/featureSupport"
                        layout="@layout/item_premium_feature" />

                </LinearLayout>

                <!-- Coming Soon Features -->
                <TextView
                    android:id="@+id/tvComingSoon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="@string/coming_soon_features"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Footer Links -->
                <LinearLayout
                    android:id="@+id/footerLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/terms_of_use"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="6dp" />

                    <TextView
                        android:id="@+id/btnPrivacyPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="6dp" />

                    <TextView
                        android:id="@+id/btnRestore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/restore"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Premium Active Container -->
                <LinearLayout
                    android:id="@+id/premiumActiveContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/premium_gold"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/imgPremiumCrown"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:lottie_fileName="crown.json"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/premium_active_title"
                                android:textColor="@color/premium_text_on_gold"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPremiumType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/premium_active"
                                android:textColor="@color/premium_text_on_gold"
                                android:textSize="14sp"
                                android:alpha="0.9" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/premium_thank_you"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom CTA Section -->
    <LinearLayout
        android:id="@+id/bottomCTA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/background"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <!-- Trial Info -->
        <TextView
            android:id="@+id/tvTrialInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/trial_info"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.2" />

        <!-- Subscribe Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:paddingVertical="6dp"
            android:text="@string/start_free_trial"
            android:textColor="@color/premium_text_on_gold"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:singleLine="false"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center"
            app:backgroundTint="@color/premium_gold"
            app:cornerRadius="28dp"
            app:elevation="4dp" />

        <!-- View Plans Link -->
        <TextView
            android:id="@+id/tvPlanSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="@string/view_all_plans"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
