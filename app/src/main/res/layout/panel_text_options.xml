<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_text_overlay"
        android:textColor="@color/toolbar_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Text Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_text_input_dark"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/etOverlayText"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/enter_text_hint"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTextOverlay"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/add_text_btn"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Color Selector -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/textColorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Font Size Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_size"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFontSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:valueFrom="16"
            android:valueTo="72"
            android:value="36"
            android:stepSize="2"
            app:trackColorActive="@color/white"
            app:trackColorInactive="#60FFFFFF"
            app:thumbColor="@color/white"
            app:thumbRadius="6dp"
            app:trackHeight="3dp"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/tvFontSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="36px"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="36dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Text Rotation Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rotation"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTextRotation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:valueFrom="0"
            android:valueTo="360"
            android:value="0"
            android:stepSize="5"
            app:trackColorActive="@color/white"
            app:trackColorInactive="#60FFFFFF"
            app:thumbColor="@color/white"
            app:thumbRadius="6dp"
            app:trackHeight="3dp"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/tvTextRotationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="36dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Overlay Count -->
    <TextView
        android:id="@+id/tvTextCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Added Text List -->
    <LinearLayout
        android:id="@+id/textListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp" />

</LinearLayout>
