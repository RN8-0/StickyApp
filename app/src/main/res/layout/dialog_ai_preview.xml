<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Image preview with rounded corners -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#F5F5F5">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            android:padding="16dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Prompt section -->
    <LinearLayout
        android:id="@+id/promptSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_ai_magic"
            android:layout_marginEnd="8dp"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Action buttons row -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <!-- Use Prompt button (for examples) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsePrompt"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✨ Use Prompt"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:iconGravity="textStart" />

        <!-- Add to Pack button (for user creations) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToPack"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📦 Add to Pack"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp" />

        <Space
            android:id="@+id/btnSpacer"
            android:layout_width="10dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Delete button (for user creations) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="#E74C3C"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="14dp"
            app:strokeColor="#E74C3C"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>
