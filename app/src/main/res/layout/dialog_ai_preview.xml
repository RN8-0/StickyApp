<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Image preview with rounded corners -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scaleType="fitCenter"
            android:padding="12dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Prompt section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/promptSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F5F3FF"
        app:strokeWidth="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ai_magic"
                android:layout_marginEnd="10dp"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#5A4BD1"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action buttons - 3 equal pill buttons -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="28dp"
        android:gravity="center">

        <!-- Edit / Use Prompt -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsePrompt"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="✨ Edit"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/primary_light"
            app:strokeWidth="1.5dp" />

        <!-- Add to Pack -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToPack"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:text="📦 Add"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp" />

        <!-- Delete -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🗑️ Delete"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#E74C3C"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:strokeColor="#FFCDD2"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

</LinearLayout>
