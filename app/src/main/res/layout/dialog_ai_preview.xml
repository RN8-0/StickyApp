<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Image preview -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scaleType="fitCenter"
            android:padding="12dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Prompt section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/promptSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F5F3FF"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="top">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ai_magic"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="2dp"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#5A4BD1"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                app:tint="#9E8EE0" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 2x2 Action buttons grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="28dp">

        <!-- Top row: Edit + Add -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsePrompt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/primary"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToPack"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Add to Pack"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@android:color/white"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <!-- Bottom row: Regenerate + Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegenerate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Regenerate"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FF9800"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="#FF9800"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:strokeColor="#FFE0B2"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#E74C3C"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="#E74C3C"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:strokeColor="#FFCDD2"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
