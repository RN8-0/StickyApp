<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style Comments Bottom Sheet - Taller with rounded top corners -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Header: Title + Sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/comments"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- Scrollable comments list - takes more vertical space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="320dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/commentLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/accent" />

    </FrameLayout>

    <!-- Divider before input -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- Input bar — pinned to bottom (YouTube-style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@color/surface">

        <!-- Avatar: ImageView instead of TextView for profile photo -->
        <ImageView
            android:id="@+id/etCommentAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_circle_accent"
            android:visibility="visible" />

        <EditText
            android:id="@+id/etCommentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:hint="@string/comment_hint"
            android:background="@null"
            android:maxLines="3"
            android:paddingVertical="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:inputType="textMultiLine|textAutoCorrect" />

        <ImageButton
            android:id="@+id/btnSendComment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_send"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="@color/accent"
            android:padding="6dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

</LinearLayout>