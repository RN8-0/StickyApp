<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar with App name and logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingBottom="12dp">

        <!-- Top bar: Back button + App name + Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ic_logo_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/installedIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Category name (pack name) -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#E0FFFFFF" />

    </LinearLayout>

    <!-- Stickers Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/chat_wallpaper_pattern"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Button container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?android:colorBackground">

        <!-- Normal Action Button (WhatsApp Ekle/Kaldır) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/add_to_whatsapp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp" />

        <!-- Premium Buttons Container (yan yana) -->
        <LinearLayout
            android:id="@+id/premiumButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Premium Badge Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumBadge"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/premium"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/premium_gold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_gem"
                app:iconGravity="textStart"
                app:iconTint="#000000" />

            <!-- Price Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrice"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/sticker_price"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
