<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Toolbar with App name and logo -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:orientation="vertical"
        android:background="@color/primary">

        <!-- Top bar: Back button + App name + Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_primary"
                android:contentDescription="Back" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_logo_white"
                app:tint="@color/text_on_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_on_primary_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPublishPackTop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/text_on_primary"
                android:visibility="gone"
                android:contentDescription="@string/publish_pack" />

            <!-- Installed Icon -->
            <ImageView
                android:id="@+id/installedIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone" />

            <!-- Premium Icon -->
            <ImageView
                android:id="@+id/premiumIconToolbar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_gem"
                app:tint="@color/premium_gold"
                android:visibility="gone" />

            <!-- Toplu Silme Onay Butonu -->
            <ImageButton
                android:id="@+id/btnConfirmDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/delete_red"
                android:visibility="gone"
                android:contentDescription="Seçilenleri Sil" />

        </LinearLayout>

    </LinearLayout>

    <!-- Publisher Strip: toolbar ile bütünleşik, ince bar -->
    <LinearLayout
        android:id="@+id/publisherStrip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/toolbar_bg"
        android:visibility="gone">

        <ImageView
            android:id="@+id/publisherAvatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_person"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_avatar_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPublisherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPublisherHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View profile"
                android:textColor="@color/text_on_primary_secondary"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Like button (çembersiz, beyaz/sarı ikon) -->
        <LinearLayout
            android:id="@+id/btnPackLike"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvPackLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Comment button (çembersiz, beyaz ikon) -->
        <LinearLayout
            android:id="@+id/btnPackComments"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_comment"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvPackCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFollowPublisher"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="64dp"
            android:text="Follow"
            android:textAllCaps="false"
            android:textSize="10sp"
            app:cornerRadius="14dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stickers Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_wallpaper_pattern"
                android:padding="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Button container (scrollable, after stickers) -->
            <LinearLayout
                android:id="@+id/bottomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:background="?android:colorBackground">

                <!-- Action Button (Add to WhatsApp / Share) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/add_to_whatsapp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:iconSize="20dp"
                    app:iconPadding="8dp" />

                <!-- Social summary text -->
                <TextView
                    android:id="@+id/tvPackSocialSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Premium Button Container -->
                <LinearLayout
                    android:id="@+id/premiumButtonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatchAd"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/watch_ad_button"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_whatsapp_small"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:iconSize="20dp"
                        app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPremiumBadge"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/get_premium_access"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/premium_gold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_gem"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:iconSize="18dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Related Packs Section -->
            <LinearLayout
                android:id="@+id/relatedPacksSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?android:colorBackground"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvRelatedTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/related_packs"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRelatedPacks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="16dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed bottom bar: custom buttons + Add to WhatsApp -->
    <LinearLayout
        android:id="@+id/fixedBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:colorBackground"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <!-- Custom buttons (Add Sticker / Delete) -->
        <LinearLayout
            android:id="@+id/customButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGridAddSticker"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/add_sticker"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/primary"
                app:iconSize="18dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGridDeleteMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/delete_mode"
                android:textColor="@color/delete_red"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/delete_red"
                app:iconSize="18dp"
                app:strokeColor="@color/delete_red"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

        <!-- Fixed Add to WhatsApp button for custom packs -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFixedWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/add_to_whatsapp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_whatsapp_small"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconSize="20dp"
            app:iconPadding="8dp"
            android:visibility="gone" />

    </LinearLayout>

    </LinearLayout>

    <!-- FAB kaldırıldı — custom butonlar artık bottomContainer'da -->

    <!-- Loading Overlay - ViewStub ile lazy inflate -->
    <ViewStub
        android:id="@+id/loadingOverlayStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/stub_loading_overlay" />

</FrameLayout>
