<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar with App name and logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingBottom="12dp">

        <!-- Top bar: Back button + App name + Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ic_logo_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Installed Icon - WhatsApp'a eklenmiş paketi gösterir -->
            <ImageView
                android:id="@+id/installedIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

            <!-- Toplu Silme Onay Butonu (Toolbar'da) -->
            <ImageButton
                android:id="@+id/btnConfirmDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/white"
                android:visibility="gone"
                android:contentDescription="Seçilenleri Sil" />

            <!-- Home butonu - En sağda -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:contentDescription="Ana Sayfa" />

        </LinearLayout>

        <!-- Category name (pack name) -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/text_on_primary_secondary" />

    </LinearLayout>

    <!-- Stickers Grid with FAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/chat_wallpaper_pattern"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- FAB: Çıkartma Ekle (sadece custom paketlerde görünür) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddSticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Çıkartma Ekle"
            android:visibility="gone"
            app:tint="@color/white"
            app:backgroundTint="@color/purple_accent"
            app:fabSize="normal"
            android:elevation="8dp" />

    </FrameLayout>

    <!-- Button container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?android:colorBackground">

        <!-- 2x2 Circular Buttons Grid -->
        <LinearLayout
            android:id="@+id/customButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Add to WhatsApp -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridAdd"
                        style="@style/CircleButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:icon="@drawable/ic_check"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/whatsapp_green" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/add_to_whatsapp"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Update WhatsApp -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridUpdate"
                        style="@style/CircleButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:icon="@drawable/ic_restore"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/blue_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/update_whatsapp"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Add Sticker -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridAddSticker"
                        style="@style/CircleButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/purple_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/add_sticker"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Delete Mode -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridDeleteMode"
                        style="@style/CircleButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:icon="@drawable/ic_delete"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/delete_red" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/delete_mode"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Legacy Button (Firebase packs) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/add_to_whatsapp"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_primary" />

        <!-- Premium Buttons Container (yan yana) -->
        <LinearLayout
            android:id="@+id/premiumButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Premium Badge Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumBadge"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/premium"
                android:textColor="@color/premium_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/premium_gold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_gem"
                app:iconGravity="textStart"
                app:iconTint="@color/premium_text" />

            <!-- Price Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrice"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/sticker_price"
                android:textColor="@color/text_on_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/success"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
