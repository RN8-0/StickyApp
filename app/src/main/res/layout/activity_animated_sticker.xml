<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <!-- ==================== STEP 1: TRIM + CROP SELECTION ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cropContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:background="@color/background">

        <!-- Top Toolbar -->
        <LinearLayout
            android:id="@+id/cropToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/toolbar_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnCropBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/white"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit_video"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Video Preview with Crop Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cropVideoCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/cropToolbar"
            app:layout_constraintBottom_toTopOf="@id/cropBottomContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/cropVideoArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F5F5F5">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/cropPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F5F5F5"
                    app:use_controller="false"
                    app:resize_mode="fit"
                    app:shutter_background_color="#F5F5F5"
                    app:surface_type="texture_view" />

                <com.sticly.CropOverlayView
                    android:id="@+id/cropOverlayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Controls: Trim + Crop Shapes -->
        <LinearLayout
            android:id="@+id/cropBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Trim Section Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_option_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvTrimInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trim_instruction"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:background="#20000000"
                    android:layout_marginHorizontal="12dp" />

                <TextView
                    android:id="@+id/tvTrimDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0s"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Timeline: RecyclerView + RangeSelectionView overlay -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="#10000000">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trimFrameRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false" />

                    <com.sticly.RangeSelectionView
                        android:id="@+id/trimRangeSelectionView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Crop Shape Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/btnCropNone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_option_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconCropNone"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_crop_none"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/labelCropNone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/crop_none"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropCircle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_option_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconCropCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_crop_circle"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/labelCropCircle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/crop_circle"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropSquare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_option_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconCropSquare"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_crop_square"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/labelCropSquare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/crop_square"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropRect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_option_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconCropRect"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_crop_rect"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/labelCropRect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/crop_rectangle"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Continue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropNext"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:text="@string/continue_btn"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="26dp"
                app:backgroundTint="@color/accent" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== STEP 2: PROCESSING =================== -->
    <LinearLayout
        android:id="@+id/processingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="@color/background">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieProcessing"
            android:layout_width="180dp"
            android:layout_height="180dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/processing_sticker"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_wait"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ==================== STEP 3: EDIT (Text/Emoji/Brush) ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modern_background"
        android:visibility="gone">

        <!-- Top Toolbar - Modern White -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/editToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_modern_toolbar"
            android:elevation="4dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnEditBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_emoji_circle_light"
                android:src="@drawable/ic_close"
                app:tint="@color/modern_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customize"
                android:textColor="@color/modern_secondary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Preview Area (shows converted WebP or video) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/editPreviewCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/editToolbar"
            app:layout_constraintBottom_toTopOf="@id/editBottomContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/editPreviewArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F5F5"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:id="@+id/editPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <!-- Draggable overlay container for text/emoji -->
            <FrameLayout
                android:id="@+id/overlayContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false" />
        </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Edit Container - Modern Floating Panel -->
        <LinearLayout
            android:id="@+id/editBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_panel"
            android:elevation="16dp"
            android:paddingTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Tool Options Panel -->
            <FrameLayout
                android:id="@+id/toolOptionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="12dp" />

            <!-- Tools Row (Add Text / Emoji) -->
            <LinearLayout
                android:id="@+id/editToolsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:id="@+id/btnToolText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_modern_tool_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconToolText"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_text"
                        app:tint="@color/modern_primary" />

                    <TextView
                        android:id="@+id/labelToolText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/text_tool"
                        android:textColor="@color/modern_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnToolEmoji"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_modern_tool_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconToolEmoji"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_emoji"
                        app:tint="@color/modern_primary" />

                    <TextView
                        android:id="@+id/labelToolEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/add_emoji_short"
                        android:textColor="@color/modern_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Save Button - Vibrant Gradient -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSticker"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Add to Pack"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:cornerRadius="28dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_vibrant_gradient"
                android:elevation="6dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== SAVE PROCESSING OVERLAY ==================== -->
    <FrameLayout
        android:id="@+id/saveProcessingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dialog_rounded"
            android:paddingHorizontal="48dp"
            android:paddingVertical="32dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieSaveProcessing"
                android:layout_width="120dp"
                android:layout_height="60dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/processing_sticker"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_wait"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
