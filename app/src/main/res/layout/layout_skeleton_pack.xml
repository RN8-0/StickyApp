<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton placeholder for a single sticker pack card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Pack thumbnail placeholder -->
    <View
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/skeleton_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Pack name placeholder -->
        <View
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:background="@drawable/skeleton_bg"
            android:layout_marginBottom="8dp" />

        <!-- Pack subtitle placeholder -->
        <View
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:background="@drawable/skeleton_bg"
            android:layout_marginBottom="10dp" />

        <!-- Sticker mini thumbnails row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/skeleton_bg" android:layout_marginEnd="4dp"/>
            <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/skeleton_bg" android:layout_marginEnd="4dp"/>
            <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/skeleton_bg" android:layout_marginEnd="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Button placeholder -->
    <View
        android:layout_width="72dp"
        android:layout_height="32dp"
        android:background="@drawable/skeleton_bg"
        android:layout_marginStart="8dp" />

</LinearLayout>
