<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_emoji"
            android:textColor="@color/toolbar_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmojiCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Emoji Size Slider -->
    <LinearLayout
        android:id="@+id/emojiSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_size"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderEmojiSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="24"
            android:valueTo="96"
            android:stepSize="2"
            android:value="48"
            app:thumbColor="@color/white"
            app:trackColorActive="@color/white"
            app:trackColorInactive="#60FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/tvEmojiSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48px"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="36dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Emoji Rotation Slider -->
    <LinearLayout
        android:id="@+id/emojiRotationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rotation"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderEmojiRotation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="360"
            android:stepSize="5"
            android:value="0"
            app:thumbColor="@color/white"
            app:trackColorActive="@color/white"
            app:trackColorInactive="#60FFFFFF" />

        <TextView
            android:id="@+id/tvEmojiRotationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="36dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Scrollable Emoji Grid -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/emojiScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fadeScrollbars="true">

        <GridLayout
            android:id="@+id/emojiGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false"
            android:background="#FFFFFF"
            android:padding="6dp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
