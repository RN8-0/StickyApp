<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#20000000"
        android:alpha="0.5" />

    <!-- Two Options Side by Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <!-- Normal (Static) Option -->
        <LinearLayout
            android:id="@+id/optionNormal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_option_card"
            android:foreground="?selectableItemBackground">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieNormal"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_fileName="astronaut.json"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_progress="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/normal_sticker"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- Animated Option -->
        <LinearLayout
            android:id="@+id/optionAnimated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_option_card"
            android:foreground="?selectableItemBackground">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimated"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                app:lottie_fileName="yay_jump.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_repeatCount="-1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/animated_short"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
