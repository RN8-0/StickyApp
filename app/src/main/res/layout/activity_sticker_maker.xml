<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B">

    <!-- Editor Container (primary view, always visible) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- Full-screen Canvas Area (no card wrapping, edge-to-edge) -->
        <FrameLayout
            android:id="@+id/photoEditorCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ja.burhanrashid52.photoeditor.PhotoEditorView
                android:id="@+id/photoEditorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/chat_wallpaper_pattern" />

            <!-- Eraser Overlay (touch events) -->
            <View
                android:id="@+id/eraserOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Loading Overlay -->
            <FrameLayout
                android:id="@+id/loadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CC000000"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieLoading"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center" />

            </FrameLayout>

        </FrameLayout>

        <!-- Empty State Placeholder -->
        <LinearLayout
            android:id="@+id/emptyStatePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/onboarding_3d_create"
                android:alpha="0.7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_select_image"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImagePlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/btn_select_image"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginTop="20dp"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/modern_primary"
                android:paddingHorizontal="28dp"
                app:icon="@drawable/ic_photo"
                app:iconTint="@color/white"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ==================== Top Toolbar (transparent overlay) ==================== -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingHorizontal="8dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Row 1: Close button (left) + Tool icons (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_dark"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/close" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Tool Icons Row -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fadeScrollbars="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnToolCrop"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_crop"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/crop_short" />

                        <ImageButton
                            android:id="@+id/btnToolRemoveBg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_photo"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/remove_bg_short" />

                        <ImageButton
                            android:id="@+id/btnToolEmoji"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_emoji"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/add_emoji_short" />

                        <ImageButton
                            android:id="@+id/btnToolText"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_text"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/add_text_short" />

                        <ImageButton
                            android:id="@+id/btnToolBrush"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_brush"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/draw_short" />

                        <ImageButton
                            android:id="@+id/btnToolEraser"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_eraser"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/eraser_short" />

                        <ImageButton
                            android:id="@+id/btnToolBorder"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_border"
                            app:tint="@android:color/white"
                            android:scaleType="centerInside"
                            android:padding="5dp"
                            android:contentDescription="@string/border_short" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Row 2: Undo/Redo (right-aligned) -->
            <LinearLayout
                android:id="@+id/undoRedoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@android:color/white"
                    android:scaleType="fitCenter"
                    android:alpha="0.7" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:scaleX="-1"
                    app:tint="@android:color/white"
                    android:scaleType="fitCenter"
                    android:alpha="0.7" />

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== Bottom Tool Options Panel ==================== -->
        <FrameLayout
            android:id="@+id/toolOptionsPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_options_panel"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Save/Add to Pack FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSaveSticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_add"
            app:tint="@android:color/white"
            app:backgroundTint="@color/modern_primary"
            app:fabSize="normal"
            app:elevation="6dp"
            app:layout_goneMarginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/toolOptionsPanel"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ad Container (hidden) -->
        <FrameLayout
            android:id="@+id/adContainerMaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
