<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_background">

    <!-- ==================== STEP 1: Type Selection ==================== -->
    <ScrollView
        android:id="@+id/typeSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:fitsSystemWindows="true"
        android:visibility="visible"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Header with emoji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨"
                android:textSize="40dp"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_to_create_sticker"
                android:textColor="@color/text_primary"
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sticker_maker_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13dp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <!-- Static Sticker Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStaticType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/modern_primary">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="📸"
                        android:textSize="28dp"
                        android:gravity="center"
                        android:background="@drawable/bg_emoji_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/static_sticker_title"
                            android:textColor="@android:color/white"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_static_desc"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12dp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Animated Sticker Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAnimatedType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/modern_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🎬"
                        android:textSize="28dp"
                        android:gravity="center"
                        android:background="@drawable/bg_emoji_circle_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/animated_sticker_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_animated_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12dp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="@color/primary"
                        android:textSize="24sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tips Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:padding="16dp"
                android:background="@drawable/bg_tips_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tips_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tips_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12dp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- Ad Container -->
            <FrameLayout
                android:id="@+id/adContainerMaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="100dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== STEP 2: Photo Editor ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:visibility="gone">

        <!-- Top Toolbar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_modern_toolbar"
            android:elevation="4dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_emoji_circle_light"
                android:src="@drawable/ic_close"
                app:tint="@color/modern_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@string/close" />

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_sticker"
                android:textColor="@color/modern_secondary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Using the existing undo/redo container but moved here for a cleaner look -->
            <LinearLayout
                android:id="@+id/undoRedoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@color/modern_primary"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:padding="8dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:scaleX="-1"
                    app:tint="@color/modern_primary"
                    android:scaleType="fitCenter" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>



        <!-- Empty State Placeholder -->
        <LinearLayout
            android:id="@+id/emptyStatePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/bg_type_option"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/onboarding_3d_create"
                android:alpha="0.9" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_select_image"
                android:textColor="@color/modern_secondary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImagePlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/btn_select_image"
                android:textColor="@color/white"
                android:layout_marginTop="24dp"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/modern_primary"
                android:paddingHorizontal="32dp" />
        </LinearLayout>

        <!-- PhotoEditor Card with Rounded Corners -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/photoEditorCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomToolsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ja.burhanrashid52.photoeditor.PhotoEditorView
                    android:id="@+id/photoEditorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/chat_wallpaper_pattern" />

                <!-- Eraser Overlay (Touch events için) -->
                <View
                    android:id="@+id/eraserOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Loading Overlay -->
                <FrameLayout
                    android:id="@+id/loadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC000000"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieLoading"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center" />

                </FrameLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Tools Container -->
        <LinearLayout
            android:id="@+id/bottomToolsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_panel"
            android:elevation="16dp"
            android:paddingTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Tool Options Panel (for brush size, colors, etc.) -->
            <FrameLayout
                android:id="@+id/toolOptionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="12dp" />

            <!-- Main Tools RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSticker"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="8dp"
                android:text="@string/save_sticker"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:cornerRadius="28dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_vibrant_gradient"
                android:elevation="6dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
