<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header Section (Slim Web Admin Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo_white"
            app:tint="@color/toolbar_icon"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sticly"
            android:textColor="@color/toolbar_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            app:tint="@color/toolbar_icon"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="@string/home_desc" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Content Area with Rounded Corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/background">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 1. ADIM: Tür Seçimi -->
                    <LinearLayout
                        android:id="@+id/typeSelectionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/how_to_create_sticker"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="24dp" />

                        <!-- Statik Kartı -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardStaticType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/card_bg">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="24dp"
                                android:gravity="center_vertical"
                                android:background="?selectableItemBackground">

                                <View
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:background="@drawable/bg_circle_primary"
                                    android:backgroundTint="@color/accent" />

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginStart="-42dp"
                                    android:src="@drawable/ic_photo"
                                    app:tint="@color/white" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="24dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/static_sticker"
                                        android:textColor="@color/text_primary"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/create_static_desc"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_back"
                                    android:rotation="180"
                                    app:tint="@color/text_hint" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Hareketli Kartı (Kilitli) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardAnimatedType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/card_bg">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="24dp"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:background="@drawable/bg_circle_primary"
                                        android:backgroundTint="@color/accent" />

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_marginStart="-42dp"
                                        android:src="@drawable/ic_video"
                                        app:tint="@color/white" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="24dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/animated_sticker"
                                            android:textColor="@color/text_primary"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/create_animated_desc"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_lock"
                                        app:tint="@color/text_hint" />
                                </LinearLayout>

                                <!-- Coming Soon Badge -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentTop="true"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_coming_soon"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/animated_sticker_coming_soon_short"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- 2. ADIM: İçerik Editörü -->
                    <LinearLayout
                        android:id="@+id/editorContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Preview Canvas -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="12dp"
                            android:layout_marginBottom="32dp"
                            app:cardBackgroundColor="@color/card_bg">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="340dp"
                                android:background="@drawable/chat_wallpaper_pattern">

                                <ImageView
                                    android:id="@+id/imagePreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="28dp"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/placeholderContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/placeholderIcon"
                                        android:layout_width="100dp"
                                        android:layout_height="100dp"
                                        android:src="@drawable/ic_photo"
                                        app:tint="@color/primary"
                                        android:alpha="0.1" />

                                    <TextView
                                        android:id="@+id/placeholderText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="20dp"
                                        android:text="@string/tap_to_select_file"
                                        android:textColor="@color/text_hint"
                                        android:textSize="16sp" />

                                </LinearLayout>

                                <!-- Badge for Media Info -->
                                <TextView
                                    android:id="@+id/tvMediaInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="20dp"
                                    android:background="@drawable/bg_fab_label"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp"
                                    android:text="00:03"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvQueueProgress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:layout_marginBottom="20dp"
                                    android:background="@drawable/bg_fab_label"
                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="8dp"
                                    android:text="1 / 5"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Controls -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/change_media"
                                android:textColor="@color/white"
                                android:textAllCaps="false"
                                android:textSize="17sp"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_photo"
                                app:iconTint="@color/white"
                                app:backgroundTint="@color/accent" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemoveBackground"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginBottom="16dp"
                                android:text="@string/ai_remove_bg"
                                android:textColor="@color/background_removal_text_color"
                                android:textAllCaps="false"
                                android:textSize="17sp"
                                app:cornerRadius="20dp"
                                android:visibility="gone"
                                app:strokeColor="@color/accent"
                                app:strokeWidth="2dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddToPack"
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:text="@string/save_sticker"
                                android:textColor="@color/white"
                                android:textAllCaps="false"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="20dp"
                                app:backgroundTint="@color/accent" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </androidx.cardview.widget.CardView>

        <!-- MODERN OVERLAY (Glassmorphism Effect) -->
        <LinearLayout
            android:id="@+id/processingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D90B141A"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="30dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginBottom="32dp">

                <ProgressBar
                    android:id="@+id/processingCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminateOnly="false"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/circular_progress_bar" />

                <ImageView
                    android:id="@+id/processingIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_video"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvProcessingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preparing_modern_version"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProcessingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.7"
                android:text="@string/processing_for_quality"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvProcessingPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="45%"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
