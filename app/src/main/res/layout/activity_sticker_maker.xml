<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo_white"
            app:tint="@color/toolbar_icon"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sticly"
            android:textColor="@color/toolbar_text"
            android:textSize="20sp"
            android:textStyle="bold" />



        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            app:tint="@color/toolbar_icon"
            android:scaleType="fitCenter"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. ADIM: Tür Seçimi (Scrollable) -->
        <ScrollView
            android:id="@+id/typeSelectionContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:visibility="visible"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/how_to_create_sticker"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Statik Kartı -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStaticType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical"
                        android:background="?selectableItemBackground">
                        <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_primary" android:backgroundTint="@color/accent" />
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="-42dp" android:src="@drawable/ic_photo" app:tint="@color/white" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/static_sticker" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_static_desc" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Hareketli Kartı -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAnimatedType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical">
                        <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_primary" android:backgroundTint="@color/accent" />
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="-42dp" android:src="@drawable/ic_video" app:tint="@color/white" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/animated_sticker" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_animated_desc" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Native Ad Container -->
                <FrameLayout
                    android:id="@+id/adContainerMaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="100dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. ADIM: İçerik Editörü (FIXED LAYOUT) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/editorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">



            <!-- Preview Canvas -->
            <androidx.cardview.widget.CardView
                android:id="@+id/previewCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottomToolsLayout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_margin="12dp">

                <FrameLayout
                    android:id="@+id/stickerEditorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/chat_wallpaper_pattern">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <!-- Placeholder -->
                    <LinearLayout
                        android:id="@+id/placeholderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/placeholderIcon"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ic_photo"
                            app:tint="@color/primary"
                            android:alpha="0.2" />
                        <TextView
                            android:id="@+id/placeholderText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/tap_to_select_file"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMediaInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="20dp"
                        android:background="@drawable/bg_fab_label"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Tools -->
            <LinearLayout
                android:id="@+id/bottomToolsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_editor_container"
                android:elevation="16dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp">
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolReset" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolUndo" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolChangeMedia" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolCrop" />
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#20000000" android:layout_marginHorizontal="8dp" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolRemoveBg" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolBrush" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolEraser" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolText" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolEmoji" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolBorder" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolFlipH" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolFlipV" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolRotate" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolFilters" />
                        <include layout="@layout/item_editor_tool" android:id="@+id/toolAdjustments" />
                    </LinearLayout>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddToPack"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/save_sticker"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/accent"
                    android:elevation="4dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Processing Overlay -->
        <LinearLayout
            android:id="@+id/processingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9000000"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="50dp"
            android:visibility="gone">
            <ProgressBar
                android:id="@+id/processingCircle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminate="true"
                android:layout_marginBottom="24dp" />
            <ImageView
                android:id="@+id/processingIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_sticker"
                app:tint="@color/accent" />
            <TextView
                android:id="@+id/tvProcessingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvProcessingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:alpha="0.7"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvProcessingPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
