<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ==================== STEP 1: Type Selection ==================== -->
    <ScrollView
        android:id="@+id/typeSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="visible"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_to_create_sticker"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Static Sticker Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStaticType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical"
                    android:background="?selectableItemBackground">
                    <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_primary" android:backgroundTint="@color/accent" />
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="-42dp" android:src="@drawable/ic_photo" app:tint="@color/white" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/static_sticker" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_static_desc" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Animated Sticker Card (Disabled) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAnimatedType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">
                    <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_primary" android:backgroundTint="@color/accent" />
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="-42dp" android:src="@drawable/ic_video" app:tint="@color/white" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/animated_sticker" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_animated_desc" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ad Container -->
            <FrameLayout
                android:id="@+id/adContainerMaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="100dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== STEP 2: Photo Editor ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top Toolbar -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/toolbar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/toolbar_icon"
                android:contentDescription="@string/close" />

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/edit_sticker"
                android:textColor="@color/toolbar_text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Floating Undo/Redo Buttons (Right Side) -->
        <LinearLayout
            android:id="@+id/undoRedoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:elevation="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/accent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/undo" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleX="-1"
                app:tint="@color/accent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/redo" />

        </LinearLayout>

        <!-- Empty State Placeholder -->
        <LinearLayout
            android:id="@+id/emptyStatePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_photo"
                app:tint="@color/text_secondary"
                android:alpha="0.3" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_select_image"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImagePlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_select_image"
                android:textColor="@color/white"
                android:layout_marginTop="24dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- PhotoEditor View -->
        <ja.burhanrashid52.photoeditor.PhotoEditorView
            android:id="@+id/photoEditorView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/chat_wallpaper_pattern"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomToolsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Eraser Overlay (Touch events için) -->
        <View
            android:id="@+id/eraserOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomToolsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loading Overlay -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#CC000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomToolsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieLoading"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Bottom Tools Container -->
        <LinearLayout
            android:id="@+id/bottomToolsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/toolbar_bg"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Tool Options Panel (for brush size, colors, etc.) -->
            <FrameLayout
                android:id="@+id/toolOptionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="12dp" />

            <!-- Main Tools RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSticker"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/save_sticker"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/accent"
                android:elevation="4dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
