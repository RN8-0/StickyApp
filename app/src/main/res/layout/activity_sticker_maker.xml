<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1B1B"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ==================== Top Bar ==================== -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="#242424">

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white"
            android:scaleType="centerInside"
            android:contentDescription="@string/close" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_sticker"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Undo -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"
            android:alpha="0.7"
            android:padding="4dp" />

        <!-- Redo -->
        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleX="-1"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"
            android:alpha="0.7"
            android:padding="4dp" />

        <!-- Save / Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSticker"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/modern_primary"
            android:minWidth="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:icon="@drawable/ic_done"
            app:iconTint="@android:color/white"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:text=""
            app:cornerRadius="18dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333" />

    <!-- ==================== Canvas Container ==================== -->
    <com.sticly.ZoomableFrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#2A2A2A"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Photo Editor Card (visible when image is loaded) -->
        <FrameLayout
            android:id="@+id/photoEditorCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ja.burhanrashid52.photoeditor.PhotoEditorView
                android:id="@+id/photoEditorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <!-- Eraser Overlay -->
            <View
                android:id="@+id/eraserOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Loading Overlay -->
            <FrameLayout
                android:id="@+id/loadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CC000000"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieLoading"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center" />

            </FrameLayout>

        </FrameLayout>

        <!-- Empty State Placeholder -->
        <LinearLayout
            android:id="@+id/emptyStatePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/onboarding_3d_create"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_select_image"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImagePlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_select_image"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/modern_primary"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_photo"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </com.sticly.ZoomableFrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#242424">

        <!-- Tool Options Panel (expanded when a tool is active) -->
        <FrameLayout
            android:id="@+id/toolOptionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2A2A"
            android:padding="12dp"
            android:visibility="gone" />

        <!-- Scrollable Tool Buttons Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- Remove BG -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false">
                    <ImageButton
                        android:id="@+id/btnToolRemoveBg"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_photo"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="@string/remove_bg_short" />
                    <TextView
                        android:id="@+id/labelToolRemoveBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remove_bg_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="-4dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Crop -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolCrop"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_crop"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/crop_short" />
                    <TextView
                        android:id="@+id/labelToolCrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crop_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Draw / Brush -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolBrush"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_brush"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/draw_short" />
                    <TextView
                        android:id="@+id/labelToolBrush"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/draw_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Eraser -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eraser"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/eraser_short" />
                    <TextView
                        android:id="@+id/labelToolEraser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eraser_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Text -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolText"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_text"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/add_text_short" />
                    <TextView
                        android:id="@+id/labelToolText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_text_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Emoji -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolEmoji"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_emoji"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/add_emoji_short" />
                    <TextView
                        android:id="@+id/labelToolEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_emoji_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Border -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btnToolBorder"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_border"
                        app:tint="#AAAAAA"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/border_short" />
                    <TextView
                        android:id="@+id/labelToolBorder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/border_short"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Sticker Tool -->
                <LinearLayout
                    android:id="@+id/toolItemSticker"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnToolSticker"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_sticker"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:contentDescription="Sticker" />

                    <TextView
                        android:id="@+id/labelToolSticker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sticker_short"
                        android:textSize="10sp"
                        android:textColor="#AAAAAA" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Ad Container (hidden) -->
        <FrameLayout
            android:id="@+id/adContainerMaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
