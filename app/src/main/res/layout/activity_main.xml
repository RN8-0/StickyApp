<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/background">

            <!-- Toolbar -->
            <LinearLayout
                android:id="@+id/toolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@color/toolbar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_logo_white"
                    app:tint="@color/white"
                    android:layout_marginEnd="8dp" />

                <!-- Title and Subtitle Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/toolbar_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/toolbarSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_stickers"
                        android:textColor="@color/text_on_primary_secondary"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnPremiumHeader"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="7dp"
                    android:visibility="visible">

                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:lottie_fileName="crown.json"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"
                        app:lottie_renderMode="automatic"
                        app:lottie_cacheComposition="true" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/menuBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/toolbar_icon"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@color/toolbar_bg"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_bg_modern"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:hint="@string/search_hint"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:elevation="1dp" />

                <ImageButton
                    android:id="@+id/btnAddStickerHeader"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_circle_accent"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:elevation="2dp"
                    android:contentDescription="@string/create_sticker_option" />
            </LinearLayout>

            <!-- Content Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/mainContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">
                    
                    <!-- Content remains same -->
                    <com.google.android.material.appbar.AppBarLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:elevation="0dp">

                        <com.google.android.material.appbar.CollapsingToolbarLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="scroll|exitUntilCollapsed">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingBottom="8dp">

                                <!-- Story-style Recent Packs (Instagram circles) -->
                                <LinearLayout
                                    android:id="@+id/storyContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="4dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <TextView
                                        android:id="@+id/storyTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_primary"
                                        android:textSize="15sp"
                                        android:fontFamily="sans-serif-medium"
                                        android:textStyle="bold"
                                        android:paddingHorizontal="16dp"
                                        android:paddingBottom="8dp"
                                        android:text="✨ Recently Added" />

                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/rvStories"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="12dp"
                                        android:clipToPadding="false"
                                        android:overScrollMode="never" />

                                </LinearLayout>

                                <!-- Regional Popular Section -->
                                <LinearLayout
                                    android:id="@+id/regionalPopularContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="8dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:paddingHorizontal="16dp"
                                        android:paddingBottom="6dp">

                                        <TextView
                                            android:id="@+id/regionalPopularTitle"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:textColor="@color/text_primary"
                                            android:textSize="15sp"
                                            android:fontFamily="sans-serif-medium"
                                            android:textStyle="bold"
                                            tools:text="🔥 Popular Stickers" />

                                    </LinearLayout>

                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/rvRegional"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="12dp"
                                        android:clipToPadding="false"
                                        android:overScrollMode="never" />

                                </LinearLayout>

                                <!-- Category Chips (Horizontal Scroll) -->
                                <HorizontalScrollView
                                    android:id="@+id/categoryScrollView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:scrollbars="none"
                                    android:paddingVertical="8dp"
                                    android:clipToPadding="false">

                                    <com.google.android.material.chip.ChipGroup
                                        android:id="@+id/categoryChipGroup"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="16dp"
                                        app:singleSelection="true"
                                        app:chipSpacingHorizontal="6dp" />

                                </HorizontalScrollView>

                                </LinearLayout>

                        </com.google.android.material.appbar.CollapsingToolbarLayout>

                    </com.google.android.material.appbar.AppBarLayout>

                    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                        android:id="@+id/swipeRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="64dp"
                            android:paddingHorizontal="8dp"
                            android:overScrollMode="never"
                            android:scrollbars="none" />

                    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <!-- Loading Overlay: shown while initial data loads -->
                <LinearLayout
                    android:id="@+id/loadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent" />

                </LinearLayout>

                <!-- Empty State View -->
                <LinearLayout
                    android:id="@+id/emptyStateView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="48dp">

                    <!-- Modern Icon Container -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@drawable/empty_state_circle_bg"
                            android:alpha="0.15" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:background="@drawable/empty_state_circle_bg"
                            android:alpha="0.25" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/emptyStateIcon"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            app:lottie_fileName="cute_tiger.json"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_renderMode="automatic"
                            app:lottie_cacheComposition="true" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/emptyStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/no_custom_packs"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp" />

                    <!-- Make Sticker button removed — use the FAB (+) at bottom-right -->

                </LinearLayout>

                <!-- AI Content (lazy-loaded via ViewStub for performance) -->
                <ViewStub
                    android:id="@+id/aiContentStub"
                    android:layout="@layout/content_ai_inline"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Profile Content (lazy-loaded via ViewStub for performance) -->
                <ViewStub
                    android:id="@+id/profileContentStub"
                    android:layout="@layout/profile_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- FAB: Create Sticker (My Stickers tab only) -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnCreateFab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/create_sticker_option"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="@color/white"
                    app:backgroundTint="@color/accent"
                    app:fabSize="normal"
                    app:elevation="6dp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Modern Bottom Navigation Bar -->
            <LinearLayout
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@color/bottom_nav_bg"
                android:orientation="horizontal"
                android:elevation="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:gravity="bottom|center_horizontal">

                <!-- Tab: Favorites -->
                <LinearLayout
                    android:id="@+id/tabFavorites"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:id="@+id/iconFavorites"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/bottom_nav_inactive" />
                    <TextView
                        android:id="@+id/textFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_favorites"
                        android:textSize="10sp"
                        android:textColor="@color/bottom_nav_inactive"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tab: AI Create -->
                <LinearLayout
                    android:id="@+id/tabAICreate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:id="@+id/iconAICreate"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ai_robot"
                        app:tint="@color/bottom_nav_inactive" />
                    <TextView
                        android:id="@+id/textAICreate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_sticker"
                        android:textSize="10sp"
                        android:textColor="@color/bottom_nav_inactive"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tab: Home/Explore (CENTER - elevated FAB style) -->
                <LinearLayout
                    android:id="@+id/tabExplore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"
                    android:background="?selectableItemBackgroundBorderless">
                    <!-- Circular elevated home button -->
                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_home_fab"
                        android:elevation="10dp">
                        <ImageView
                            android:id="@+id/iconExplore"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_home"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/textExplore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/explore"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/bottom_nav_active"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tab: My Stickers -->
                <LinearLayout
                    android:id="@+id/tabMyStickers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:id="@+id/iconMyStickers"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sticker"
                        app:tint="@color/bottom_nav_inactive" />
                    <TextView
                        android:id="@+id/textMyStickers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_stickers_tab"
                        android:textSize="10sp"
                        android:textColor="@color/bottom_nav_inactive"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tab: Profile -->
                <LinearLayout
                    android:id="@+id/tabProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:id="@+id/iconProfile"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bottom_nav_inactive" />
                    <TextView
                        android:id="@+id/textProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile"
                        android:textSize="10sp"
                        android:textColor="@color/bottom_nav_inactive"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/toolbar_bg"
        android:clipToPadding="false">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/toolbar_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_logo_white"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/toolbar_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="v2.1"
                android:textColor="@color/text_on_primary_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Menu Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- Premium -->
                <LinearLayout
                    android:id="@+id/navPremium"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_premium"
                        app:tint="@color/premium_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/premium"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Restore Purchases -->
                <LinearLayout
                    android:id="@+id/navRestorePurchases"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_restore"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/restore_purchases"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/divider" />

                <!-- Contact -->
                <LinearLayout
                    android:id="@+id/navContact"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_contact"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/contact_us"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Rate -->
                <LinearLayout
                    android:id="@+id/navRate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_rate"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/rate_us"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Suggest -->
                <LinearLayout
                    android:id="@+id/navSuggest"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_suggest"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/suggest_sticker"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Share -->
                <LinearLayout
                    android:id="@+id/navShare"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/share_app"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/divider" />

                <!-- FAQ -->
                <LinearLayout
                    android:id="@+id/navFaq"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_faq"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/faq"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:id="@+id/navAbout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/about"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Notifications -->
                <LinearLayout
                    android:id="@+id/navNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/notification_settings"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Privacy -->
                <LinearLayout
                    android:id="@+id/navPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_privacy"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
