<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@color/white"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <!-- Üst Satır: Paket Adı + Add Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Sol: Paket Adı + Emoji/Badge'ler -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Premium taç -->
            <ImageView
                android:id="@+id/crownIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_gem"
                android:visibility="gone" />

            <!-- Paket Adı -->
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Elon Musk" />

            <!-- Animated/Static Badge -->
            <TextView
                android:id="@+id/packTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="9sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:visibility="gone" />

            <!-- Yeni Badge -->
            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/new_badge"
                android:textSize="9sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/badge_new"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:visibility="gone" />

            <!-- Zaman -->
            <TextView
                android:id="@+id/timeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:visibility="gone"
                tools:text="3h" />

        </LinearLayout>

        <!-- Favori Butonu -->
        <ImageButton
            android:id="@+id/btnFavoriteNew"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:contentDescription="@string/add_to_favorites" />

        <!-- Paket Silme Butonu (Custom paketler için) -->
        <ImageButton
            android:id="@+id/btnDeletePack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:visibility="gone"
            android:contentDescription="@string/delete_mode" />

        <!-- Add Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_add_short"
            android:textSize="12sp"
            android:textColor="@color/accent"
            app:icon="@drawable/ic_whatsapp_small"
            app:iconSize="16dp"
            app:iconTint="@color/accent"
            app:iconPadding="4dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <!-- İkinci Satır: Yayıncı fotoğrafı + Yayıncı + İndirme sayısı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/publisherPhoto"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_circle_gray"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Shahir • 17 stickers • 80k downloads" />

    </LinearLayout>

    <!-- Çıkartma Önizlemeleri -->
    <LinearLayout
        android:id="@+id/stickerPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center" />

    <!-- Hidden compatibility views - zero size, no layout cost -->
    <TextView android:id="@+id/downloadCount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/installedBadge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/premiumContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <TextView android:id="@+id/premiumBadge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>
    <ImageView android:id="@+id/checkIcon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageView android:id="@+id/tray" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageButton android:id="@+id/btnFavorite" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageButton android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/rankNumber" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</LinearLayout>
