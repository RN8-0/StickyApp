<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:background="?selectableItemBackground">

    <!-- Üst Bilgi Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Paket Adı + Badge'ler -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rank Number (Regional Popular için) -->
            <TextView
                android:id="@+id/rankNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="1" />

            <!-- Premium taç -->
            <ImageView
                android:id="@+id/crownIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_gem"
                android:visibility="gone" />

            <!-- Paket Adı -->
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Niños 😎" />

            <!-- Yeni Badge -->
            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/new_badge"
                android:textSize="9sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/badge_new"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:visibility="gone" />

            <!-- Zaman -->
            <TextView
                android:id="@+id/timeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                tools:text="3h" />

        </LinearLayout>

        <!-- Favori Butonu -->
        <ImageButton
            android:id="@+id/btnFavoriteNew"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:contentDescription="@string/add_to_favorites" />

        <!-- Silme Butonu -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/delete_red"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:contentDescription="@string/delete_pack"
            android:visibility="gone" />

        <!-- Ekle Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_add_short"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:icon="@drawable/ic_add"
            app:iconSize="14dp"
            app:iconTint="@color/white"
            app:iconPadding="4dp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <!-- İkinci Satır: Yayıncı + İndirme sayısı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Yayıncı -->
        <TextView
            android:id="@+id/pub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="anapech82" />

        <!-- Ayraç -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:text="•"
            android:textSize="11sp"
            android:textColor="@color/text_hint" />

        <!-- İndirme sayısı -->
        <TextView
            android:id="@+id/downloadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            tools:text="13.6K indirme" />

        <!-- Yüklü Badge -->
        <TextView
            android:id="@+id/installedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/installed"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:background="@drawable/badge_installed"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <!-- Premium Badge -->
        <LinearLayout
            android:id="@+id/premiumContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/premiumBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium"
                android:textSize="10sp"
                android:textColor="@color/premium_text_on_gold"
                android:textStyle="bold"
                android:background="@drawable/badge_premium"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

        <!-- Yüklü simgesi -->
        <ImageView
            android:id="@+id/checkIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Çıkartma Önizlemeleri -->
    <HorizontalScrollView
        android:id="@+id/stickerScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/stickerPreviewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:gravity="start|center_vertical" />

    </HorizontalScrollView>

    <!-- Gizli Elemanlar (mevcut kod uyumluluğu için) -->
    <ImageView
        android:id="@+id/tray"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/count"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />



</LinearLayout>
