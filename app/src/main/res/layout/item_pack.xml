<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Tray Image -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/tray"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop" />

            <!-- Premium taş simgesi - sağ üst köşe -->
            <ImageView
                android:id="@+id/crownIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_gem"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/checkIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

            <!-- Yeni Badge - sol üst köşe -->
            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:text="@string/new_badge"
                android:textSize="8sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/badge_new"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Orta kısım: İsim, yayıncı, sticker sayısı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/pub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Sticker sayısı ve indirme sayısı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/downloadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_download_small"
                    android:drawablePadding="2dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Badge'ler (dikey ortada) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp">

            <!-- Yüklü Badge -->
            <TextView
                android:id="@+id/installedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/installed"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_installed"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />

            <!-- Premium Container (dikey ortada) -->
            <LinearLayout
                android:id="@+id/premiumContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/premiumBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/premium"
                    android:textSize="10sp"
                    android:textColor="@color/premium_text"
                    android:background="@drawable/badge_premium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/premiumPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sticker_price"
                    android:textSize="12sp"
                    android:textColor="@color/success"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Silme butonu (özel paketler için) -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:visibility="gone"
            app:tint="@color/delete_red"
            android:contentDescription="@string/delete_pack" />

        <!-- Favori butonu (en sağda) -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:contentDescription="@string/add_to_favorites" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
