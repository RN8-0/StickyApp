<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#25D366</item>
        <item name="colorPrimaryDark">#1DA851</item>
        <item name="colorAccent">#25D366</item>
        <item name="android:statusBarColor">?colorPrimaryDark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Dairesel Buton Stili -->
    <style name="CircleButton" parent="Widget.MaterialComponents.Button.Icon">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="shapeAppearanceOverlay">@style/CircleAppearance</item>
    </style>

    <style name="CircleAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
